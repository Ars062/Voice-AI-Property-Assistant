# =============================================================================
# Voice AI Property Assistant - environment template
# Copy to `.env` and fill in the values. NEVER commit the real `.env`.
# =============================================================================

# --- LLM: Groq (only supported provider) -----------------------------------
LLM_PROVIDER=groq
GROQ_API_KEY=
# Must exist for your Groq account. qwen/qwen3.8-27b is verified on this account.
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_TEMPERATURE=0.1
GROQ_MAX_TOKENS=900
GROQ_TIMEOUT_SECONDS=60

# --- PostgreSQL (source of truth) ------------------------------------------
# Local docker-compose instance (see docker-compose.yml)
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=postgres
POSTGRES_DB=voice_property
POSTGRES_PORT=5433

# Application connection (write role - used by migrations + booking)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/voice_property

# Restricted read-only role used for every property search.
# Created by scripts/init_db.py; can only SELECT from the app schema.
DATABASE_READONLY_URL=postgresql+psycopg://voice_readonly:voice_readonly_pw@localhost:5433/voice_property

# --- Query safety ----------------------------------------------------------
QUERY_MAX_ROWS=25
QUERY_TIMEOUT_SECONDS=10
QUERY_STATEMENT_TIMEOUT_MS=8000

# --- Voice: STT ------------------------------------------------------------
WHISPER_MODEL_SIZE=base
WHISPER_COMPUTE_TYPE=int8
WHISPER_DEVICE=cpu
WHISPER_MODEL_DIR=models/whisper

# --- Voice: TTS ------------------------------------------------------------
TTS_PROVIDER=auto           # auto | piper | sapi
TTS_PIPER_VOICE=en_US-lessac-medium
TTS_PIPER_MODEL_DIR=models/piper
TTS_SAPI_VOICE=Microsoft David Desktop

# --- Avatar (CPU lip-sync) -------------------------------------------------
# auto     -> musetalk if its weights + torch are present, otherwise puppet
# puppet   -> fast CPU mouth-region overlay (default, no weights)
# musetalk -> real MuseTalk lip-sync on CPU (slow)
AVATAR_ENGINE=auto
AVATAR_MUSETALK_DIR=models/musetalk
# Optional "x1,y1,x2,y2" face box. Empty = derive from the portrait size.
AVATAR_MUSETALK_BBOX=
AVATAR_PORTRAIT=assets/portrait.png
AVATAR_FPS=25
AVATAR_CPU_RENDER_FPS=6      # unique frames actually rendered per second on CPU
AVATAR_CPU_THREADS=0         # 0 = leave torch defaults
AVATAR_CPU_QUANTIZE=0        # 1 = int8 dynamic quantization of UNet linears
AVATAR_BATCH_SIZE=2
AVATAR_MAX_SECONDS=15        # cap avatar animation length for fast responses
AVATAR_MAX_WIDTH=384         # GIF downscale width

# --- Server ----------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
